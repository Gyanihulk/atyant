Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^index\.html$ index.php [END]
RewriteRule ^login\.html$ login.php [END]
RewriteRule ^(?:server|backups|deployment|tests|tools|tmp)(?:/|$) - [F,L]
RewriteRule ^(?:PROGRESS\.md|HOSTINGER-LOGIN\.md|\.git.*)$ - [F,L]
